@mode(host.scripted)

from debug.assert import (expectEq);
from find import (FindState, emptyFind, findIn, nextMatch, selectedStart, findLabel, findAll,
    foldChar);

## The match positions as "0,4,8" (lists compare by identity, not contents).
func positions(starts: list[int]): string {
    var text = "";
    for (start in starts) {
        if (text != "") {
            text = text + ",";
        }
        text = text + start.to_string();
    }
    return text;
}

func test_find_all_simple(): void {
    expectEq(positions(findAll("the cat and the hat", "the")), "0,12", "two matches");
    expectEq(positions(findAll("abc", "x")), "", "no match");
    return;
}

func test_empty_query_or_text_has_no_matches(): void {
    expectEq(positions(findAll("abc", "")), "", "empty query");
    expectEq(positions(findAll("", "a")), "", "empty text");
    expectEq(positions(findAll("", "")), "", "both empty");
    return;
}

func test_overlapping_matches(): void {
    expectEq(positions(findAll("aaa", "aa")), "0,1", "aa in aaa");
    expectEq(positions(findAll("aaaa", "aa")), "0,1,2", "aa in aaaa");
    expectEq(positions(findAll("abababa", "aba")), "0,2,4", "aba in abababa");
    return;
}

func test_query_longer_than_text(): void {
    expectEq(positions(findAll("ab", "abc")), "", "longer query");
    return;
}

func test_ignores_letter_case(): void {
    expectEq(positions(findAll("Fox fox FOX", "fox")), "0,4,8", "ASCII");
    expectEq(positions(findAll("ÉCOLE école", "école")), "0,6", "Latin-1");
    expectEq(positions(findAll("ΑΒΓ αβγ", "αβγ")), "0,4", "Greek");
    expectEq(positions(findAll("МОСКВА москва", "Москва")), "0,7", "Cyrillic");
    expectEq(positions(findAll("ŁÓDŹ łódź", "łódź")), "0,5", "Latin Extended-A");
    expectEq(positions(findAll("ČEŠKÝ ŐR", "češký őr")), "0", "Latin Extended-A across words");
    expectEq(positions(findAll("ŸVES ÿves", "ÿves")), "0,5", "Ÿ folds into Latin-1");
    expectEq(positions(findAll("ΟΔΟΣ οδος οδοσ", "οδοσ")), "0,5,10", "final sigma matches sigma");
    expectEq(positions(findAll("ΆΈΉΊΌΎΏ", "άέήίόύώ")), "0", "accented Greek capitals");
    return;
}

func test_ignores_letter_case_in_other_scripts(): void {
    expectEq(positions(findAll("ԱՐԵՎ արեվ", "արեվ")), "0,5", "Armenian");
    expectEq(positions(findAll("ＦＯＸ ｆｏｘ", "ｆｏｘ")), "0,4", "full-width Latin");
    expectEq(positions(findAll("ǄEMAL ǆemal", "ǆemal")), "0,6", "Latin Extended-B");
    expectEq(positions(findAll("ẞ ß", "ß")), "0,2", "capital sharp s");
    return;
}

func test_letters_whose_case_forms_differ_in_length_are_not_folded(): void {
    # ß / SS and İ / i̇ would change the number of characters: left alone.
    expectEq(positions(findAll("STRASSE", "straße")), "", "ß does not match SS");
    expectEq(positions(findAll("straße", "STRAßE")), "0", "ß matches itself");
    expectEq(foldChar(c"İ"), 304, "İ stays");
    expectEq(foldChar(c"ı"), 305, "ı stays");
    expectEq(foldChar(c"ſ"), 383, "ſ stays");
    return;
}

func test_fold_char_is_to_lower_except_final_sigma(): void {
    let letters = "AZÀÞΑΩАЯЀЏĀĶĹŇŊŶŸŹŽŁŐΆΈΊΌΎΏԱՖazàαωаяёłÿ";
    for (c in letters.scalars()) {
        expectEq(foldChar(c), c.toLower().toInt(), "fold of " + c.toString());
    }
    expectEq(foldChar(c"ς"), 963, "final sigma folds to sigma");
    expectEq(foldChar(c"Σ"), 963, "capital sigma");
    # Not letters: unchanged.
    expectEq(foldChar(c"×"), 215, "multiplication sign");
    expectEq(foldChar(c"0"), 48, "digit zero");
    expectEq(foldChar(c"😀"), 128512, "emoji");
    return;
}

func test_positions_are_scalar_indexes(): void {
    expectEq(positions(findAll("😀 fox 😀 fox", "fox")), "2,8", "after emoji");
    expectEq(positions(findAll("日本語の日本", "日本")), "0,4", "CJK");
    expectEq(positions(findAll("a😀😀b", "😀")), "1,2", "emoji query");
    return;
}

## Next from the selection the last Next left: the match it selected (the
## start of the text before the first Next).
func nextFrom(state: FindState): FindState {
    var start = 0;
    var length = 0;
    if (state.current >= 0) {
        start = selectedStart(state);
        length = state.query.length();
    }
    let next = nextMatch(state, start, length);
    return next;
}

func test_next_cycles_through_the_matches(): void {
    var f = findIn("one two one two one", "one");
    expectEq(findLabel(f), "3 matches", "before Next");
    expectEq(selectedStart(f), -1, "nothing selected yet");
    f = nextFrom(f);
    expectEq(selectedStart(f), 0, "first");
    expectEq(findLabel(f), "1 of 3", "label after the first Next");
    f = nextFrom(f);
    expectEq(selectedStart(f), 8, "second");
    f = nextFrom(f);
    expectEq(selectedStart(f), 16, "third");
    expectEq(findLabel(f), "3 of 3", "label at the last");
    f = nextFrom(f);
    expectEq(selectedStart(f), 0, "wraps to the first");
    expectEq(findLabel(f), "1 of 3", "label after wrapping");
    return;
}

func test_next_visits_overlapping_matches(): void {
    var f = findIn("aaa", "aa");
    f = nextMatch(f, 0, 0);
    expectEq(selectedStart(f), 0, "from the start");
    f = nextMatch(f, 0, 2);
    expectEq(selectedStart(f), 1, "the overlapping one");
    f = nextMatch(f, 1, 2);
    expectEq(selectedStart(f), 0, "wraps");
    return;
}

func test_next_goes_on_from_the_insertion_point(): void {
    let f = findIn("x x x x", "x");
    expectEq(selectedStart(nextMatch(f, 0, 0)), 0, "at a match");
    expectEq(selectedStart(nextMatch(f, 3, 0)), 4, "between matches");
    expectEq(findLabel(nextMatch(f, 3, 0)), "3 of 4", "label");
    expectEq(selectedStart(nextMatch(f, 7, 0)), 0, "at the end: wraps to the first");
    # A selection that is not a match: the first match after its start.
    expectEq(selectedStart(nextMatch(f, 1, 3)), 2, "after a selection");
    return;
}

func test_find_labels(): void {
    var f = emptyFind();
    expectEq(findLabel(f), "", "no query");
    f = findIn("abc", "b");
    expectEq(findLabel(f), "1 match", "one match");
    f = findIn("abc", "z");
    expectEq(findLabel(f), "No matches", "none");
    f = nextMatch(f, 0, 0);
    expectEq(selectedStart(f), -1, "Next without matches selects nothing");
    f = findIn("abc", "");
    expectEq(findLabel(f), "", "query cleared");
    return;
}

func test_an_edit_or_a_new_query_starts_over(): void {
    # The text changed (or another file was opened with the same query): no
    # match is selected any more, so the label shows the count, never a
    # stale "2 of n".
    var f = nextFrom(nextFrom(findIn("x x x", "x")));
    expectEq(findLabel(f), "2 of 3", "second match");
    f = findIn("x x x x", "x");
    expectEq(findLabel(f), "4 matches", "after an edit");
    f = findIn("x x x x", "x ");
    expectEq(findLabel(f), "3 matches", "new query");
    return;
}

func test_next_leaves_the_old_state_alone(): void {
    let before = findIn("aa", "a");
    let after = nextMatch(before, 0, 0);
    expectEq(before.current, -1, "the original is unchanged");
    expectEq(after.current, 0, "the copy moved");
    return;
}
